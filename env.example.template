# ============================================================
# 环境变量示例（复制为 .env 后按需填写）
# 数据库自动选型逻辑见 ARCHITECTURE.md 4.3 节
# 变量名以代码实际读取为准（server/db/index.js、server/core/auth/password.js）
# ============================================================

# 登录密码（服务器模式必填，不落库，仅做常量时间比较；缺失时无法登录）
AUTH_PASSWORD=

# 敏感字段 AES-256-GCM 信封加密主密钥（64 位 hex = 32 字节；生产环境必填）。
# 未设置时本地开发会自动生成随机密钥并持久化到 server/core/.secret-key（重启不失效）。
ENCRYPTION_KEY=

# 显式指定数据库驱动：sqlite | turso | d1（不设置则按运行环境自动选型）
DB_DRIVER=

# SQLite（本地开发 / Docker，node:sqlite 内置；默认 ./sqlite.db）
SQLITE_PATH=

# Turso / libSQL（Vercel / Deno 或远程部署）
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Cloudflare D1 REST（本地 DB_DRIVER=d1 时使用；Worker 内走 DB binding 无需这些）
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# Node 本地服务端口（默认 3000）
PORT=
